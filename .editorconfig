root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.ts]
quote_type = single

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Liquibase checksums and seed fixtures change if an editor rewrites whitespace.
[profiles/**]
trim_trailing_whitespace = false
insert_final_newline = false

[**/db/changelog/**]
trim_trailing_whitespace = false
insert_final_newline = false

[tools/seed-data/**]
trim_trailing_whitespace = false
insert_final_newline = false

[sitmun-backend/src/test/resources/**]
trim_trailing_whitespace = false
insert_final_newline = false
