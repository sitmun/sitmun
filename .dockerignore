# Root-level .dockerignore
# Common exclusions for all Docker builds
# Note: This applies to build contexts at the root level

# Git
.git/
.gitignore
.gitattributes

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.cursor/
.run/
out/
bin/

# System files
.DS_Store
Thumbs.db
.directory

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Documentation (not needed in build)
**/*.md
!README.md
CHANGELOG.md
docs/
sitmun.github.io/

# Generated configuration files
docker/front/config/default.conf

# Python (if any)
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Dependencies (exclude installed trees, keep package.json and pnpm-lock.yaml)
node_modules/
**/node_modules/
**/build/
**/.gradle/

# Mobile apps are not copied into an image. pnpm ci still needs the two
# workspace manifests, so those files stay in the build context.
sitmun-mobile/*
!sitmun-mobile/sitmun-edition
sitmun-mobile/sitmun-edition/*
!sitmun-mobile/sitmun-edition/package.json
!sitmun-mobile/sitmun-touristic
sitmun-mobile/sitmun-touristic/*
!sitmun-mobile/sitmun-touristic/package.json
e2e/

# Keep these files (DO NOT exclude):
# package.json, pnpm-lock.yaml (frontend)
# build.gradle, settings.gradle, gradle.properties (backend)
# gradlew, gradle/ (backend)
# src/ (source code)
# *.ts, *.js, *.java (source files)
# compose.yaml, Dockerfile, .dockerignore
