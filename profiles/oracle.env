###############################################################################
# Dockerized Oracle with Minimal Seed - PRODUCTION MODE
#
# This profile is designed for PRODUCTION deployments with:
#   - Frontend: ENVIRONMENT=production (optimized build, shows "production" in UI)
#   - Backend: SPRING_PROFILES_ACTIVE=prod (production logging and behavior)
#   - Minimal seed data for production use
#
# WARNING: This profile is NOT for local development. For development, use:
#          profiles/development-oracle.env
#
# Usage:
#   1. cp profiles/oracle.env .env
#   2. ./setup.sh appends SITMUN_USER_SECRET, MIDDLEWARE_SECRET, and
#      SITMUN_MBTILES_JOB_HANDLE_SECRET when those keys are absent
#   3. docker compose up -d --pull always --no-build
###############################################################################

COMPOSE_PROFILES=oracle

# --- Base URL ---
# PUBLIC_URL_SCHEME=http
# PUBLIC_HOSTNAME=localhost
PUBLIC_PORT=9000
# PUBLIC_BASE_PATH=/

# --- Container ---
# LOCAL_PORT=9000
# LOCAL_BASE_PATH=/
# Frontend environment: 'production' enables Angular production optimizations
# (minification, tree-shaking, no source maps) and shows "production" in the UI.
ENVIRONMENT=production

# --- Database ---
SITMUN_CONFIG_DIR=oracle
DATABASE_TYPE=oracle
DATABASE_URL=jdbc:oracle:thin:@//oracle:1521/
# DATABASE=sitmun3
# DATABASE_USERNAME=sitmun3
# DATABASE_PASSWORD=sitmun3

# --- Hibernate ---
# Dialect and boolean type mapping loaded from application-oracle.yml via 'oracle' profile
# Expected startup warning:
#   HHH90006001 for hibernate.type.preferred_boolean_jdbc_type
# This is informational (incubating setting), and required for Oracle boolean mapping.
# DDL mode set to 'validate' - catches schema mismatches at startup
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Liquibase (minimal seed) ---
SPRING_LIQUIBASE_CHANGE_LOG=file:/usr/src/config/liquibase/master.xml
SPRING_LIQUIBASE_CONTEXTS=

# --- Proxy ---
# FORCE_USE_OF_PROXY=true

# --- Security ---
# SITMUN_USER_SECRET=
# MIDDLEWARE_SECRET=
# SITMUN_MBTILES_JOB_HANDLE_SECRET=

# --- First-run setup ---
# When the admin password is null, these run the setup wizard at startup.
# The password must be 8 to 50 characters and differ from the username.
# Remove them after the backend is healthy, then change the password in the admin.
# SITMUN_BOOTSTRAP_ADMIN_PASSWORD=
# SITMUN_BOOTSTRAP_LANGUAGE=

# --- Production Mode ---
# Backend Spring profile: 'prod,oracle' enables production behavior with Oracle-specific settings
# The 'oracle' profile loads application-oracle.yml (dialect + boolean type mapping)
# Combined with logging levels below, ensures production-ready operation
SPRING_PROFILES_ACTIVE=prod,oracle
# Oracle 11 installs use the oracle-11 profile.
# SPRING_PROFILES_ACTIVE=prod,oracle-11
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SITMUN=INFO
