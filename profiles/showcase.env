###############################################################################
# Showcase — PostgreSQL, published images, sales seed
#
# Three applications on a fresh database: SDI Viewer, Camí de Cavalls, and
# Case processing support. Liquibase context `showcase` loads that seed after
# the baseline. An empty context list would load it on every install, so this
# file sets the context.
#
# Usage. setup appends SITMUN_USER_SECRET,
# MIDDLEWARE_SECRET, and SITMUN_MBTILES_JOB_HANDLE_SECRET when those keys
# are absent. An .env that already exists is kept.
#
# Windows:
#   git clone https://github.com/sitmun/sitmun.git
#   cd sitmun
#   Copy-Item profiles\showcase.env .env
#   .\setup.ps1
#   docker compose -p sitmun-showcase up -d --pull always --no-build
#
# Linux:
#   git clone https://github.com/sitmun/sitmun.git
#   cd sitmun
#   cp profiles/showcase.env .env
#   ./setup.sh
#   docker compose -p sitmun-showcase up -d --pull always --no-build
#
# The project name gives this database its own volume. It does not replace a
# development database. demo / demo opens all three applications. The first
# visit to Admin asks for a password and a language.
#
# Columns are English. Spanish and Catalan are translations. To show Spanish
# by default, in admin disable French and Aranese, then change the default
# language from en to es.
###############################################################################

COMPOSE_PROFILES=postgres

# --- Base URL ---
# PUBLIC_URL_SCHEME=http
# PUBLIC_HOSTNAME=localhost
PUBLIC_PORT=9000
# PUBLIC_BASE_PATH=/

# --- Container ---
# LOCAL_PORT=9000
# LOCAL_BASE_PATH=/
ENVIRONMENT=production

# --- Database ---
SITMUN_CONFIG_DIR=showcase
DATABASE_TYPE=postgres
DATABASE_URL=jdbc:postgresql://postgres:5432/
# DATABASE=sitmun3
# DATABASE_USERNAME=sitmun3
# DATABASE_PASSWORD=sitmun3

# --- Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Liquibase ---
SPRING_LIQUIBASE_CHANGE_LOG=file:/usr/src/config/liquibase/master.xml
SPRING_LIQUIBASE_CONTEXTS=showcase

# --- Proxy ---
# FORCE_USE_OF_PROXY=true

# --- Security ---
# SITMUN_USER_SECRET=
# MIDDLEWARE_SECRET=
# SITMUN_MBTILES_JOB_HANDLE_SECRET=

# --- First-run setup ---
# Left commented, the presenter uses the wizard. Uncomment to open straight to login.
# The password below is a placeholder, not a real secret. Remove it after the first start.
# SITMUN_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# SITMUN_BOOTSTRAP_LANGUAGE=es

# --- Runtime ---
# prod,postgres loads application-postgres.yml. It does not load the development seed.
SPRING_PROFILES_ACTIVE=prod,postgres
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SITMUN=INFO
